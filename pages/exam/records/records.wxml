<view class="page">
  <view class="nav-row" style="margin-top: {{navTop}}px; height: {{navHeight}}px;">
    <view class="back-btn" bindtap="back">返回</view>
    <view class="nav-title">我的学习记录</view>
    <view class="nav-spacer"></view>
  </view>

  <view class="record-wrap">
    <view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="openPaper">
      <view class="name">{{item.title}}</view>
      <view class="meta">
        <text>已答 {{item.answered}}</text>
        <text>错题 {{item.wrong}}</text>
        <text>收藏 {{item.favorites}}</text>
      </view>
    </view>
  </view>
</view>
