<view class="page"><view class="record-wrap">
    <view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="openPaper">
      <view class="name">{{item.title}}</view>
      <view class="meta">
        <text>已答 {{item.answered}}</text>
        <text>错题 {{item.wrong}}</text>
        <text>收藏 {{item.favorites}}</text>
      </view>
    </view>
  </view>
</view>
