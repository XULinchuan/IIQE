.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #111;
  font-size: 26rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #111;
  font-weight: 600;
  margin: 0 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nav-spacer {
  width: 92rpx;
}

.record-wrap {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.card {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.name {
  font-size: 32rpx;
  color: #111;
  margin-bottom: 10rpx;
}

.meta {
  display: flex;
  gap: 18rpx;
  color: #6b7280;
  font-size: 26rpx;
}
