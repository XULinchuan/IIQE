.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 24rpx;
  box-sizing: border-box;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #111;
  font-size: 34rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
  margin: 0 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
}

.nav-spacer {
  width: 92rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
}

.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.user-main {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f3f4f6;
}

.avatar-wrap {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  margin: 0;
  padding: 0;
  width: 96rpx;
  height: 96rpx;
  border: none;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 34rpx;
}

.user-info {
  margin-left: 16rpx;
  flex: 1;
}

.nick {
  font-size: 34rpx;
  color: #111;
  font-weight: 600;
}

.nick.clickable {
  text-decoration: none;
}

.sub {
  margin-top: 6rpx;
  font-size: 34rpx;
  color: #6b7280;
  line-height: 1.4;
}

.login-btn {
  margin-top: 16rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #111827;
  color: #fff;
  font-size: 34rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.record-wrap {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.fold {
  font-size: 34rpx;
  color: #6b7280;
}

.auth-wrap {
  margin-top: 14rpx;
}

.dialog-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.dialog-card {
  width: 100%;
  background: #fff;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 24rpx 24rpx 36rpx;
  box-sizing: border-box;
}

.dialog-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  font-size: 34rpx;
  line-height: 44rpx;
  color: #111;
  text-align: center;
}

.dialog-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
  text-align: center;
}

.dialog-sub {
  margin-top: 12rpx;
  font-size: 34rpx;
  color: #666;
  text-align: center;
}

.qr-wrap {
  margin-top: 22rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}

.qr-loading {
  width: 360rpx;
  height: 360rpx;
  border-radius: 14rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-image {
  width: 360rpx;
  height: 360rpx;
  border-radius: 14rpx;
  background: #f5f5f5;
  display: block;
}

.save-qr-btn {
  margin: 20rpx auto 0;
  width: 360rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #eef2ff;
  color: #1f2937;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #eee;
  border-bottom: 1rpx solid #eee;
  min-height: 96rpx;
}

.code-label {
  width: 152rpx;
  font-size: 34rpx;
  color: #111;
  white-space: nowrap;
}

.code-input {
  flex: 1;
  font-size: 34rpx;
  color: #111;
}

.paste-btn {
  width: 92rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: #f3f4f6;
  color: #555;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.verify-btn {
  margin: 46rpx auto 0;
  width: 440rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: #16a34a;
  color: #fff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.verify-btn.disabled {
  background: #7ccf9f;
}

.nick-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.nick-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 12rpx;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nick-btn.secondary {
  background: #eef2ff;
  color: #1f2937;
}

.nick-btn.primary {
  background: #16a34a;
  color: #fff;
}

.nick-btn.disabled {
  opacity: 0.7;
}
