.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 24rpx;
  box-sizing: border-box;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.back-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #111;
  font-size: 26rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #111;
  margin: 0 12rpx;
}

.nav-spacer {
  width: 92rpx;
}

.card {
  margin-top: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.label {
  color: #666;
  font-size: 24rpx;
}

.value {
  margin-top: 8rpx;
  color: #111;
  font-size: 26rpx;
  font-weight: 600;
}

.sub {
  margin-top: 6rpx;
  color: #0f766e;
  font-size: 24rpx;
}

.section-title {
  color: #111;
  font-size: 26rpx;
  font-weight: 600;
}

.action-btn {
  margin-top: 14rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #111827;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-image {
  margin: 18rpx auto 0;
  width: 360rpx;
  height: 360rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  display: block;
}
