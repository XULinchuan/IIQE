{
  "darkmode": true,
  "pages": [
    "pages/exam/home/home",
    "pages/exam/me/me",
    "pages/agent/qrcode/qrcode"
  ],
  "subPackages": [
    {
      "root": "pkg-exam",
      "pages": [
        "paper/paper",
        "volume_collection/volume_collection",
        "question/question",
        "records/records"
      ]
    }
  ],
  "preloadRule": {
    "pages/exam/home/home": {
      "network": "all",
      "packages": [
        "pkg-exam"
      ]
    }
  },
  "themeLocation": "theme.json",
  "window": {
    "navigationBarTitleText": "IIQE 题库",
    "navigationStyle": "default",
    "navigationBarTextStyle": "black",
    "navigationBarBackgroundColor": "#f6f7f9",
    "backgroundColor": "#f6f7f9",
    "backgroundColorTop": "#f6f7f9",
    "backgroundColorBottom": "#f6f7f9",
    "backgroundTextStyle": "dark"
  },
  "resolveAlias": {
    "@behaviors/*": "behaviors/*"
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
